    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "better-auth": "1.7.7",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/pg": "^8.15.6"
  },
  "packageManager": "pnpm@10.17.1"
