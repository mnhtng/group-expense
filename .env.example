# Copy this template to .env.local, and fill in the actual Neon project credentials.
# NEVER commit .env.local, actual database URLs, Neon API keys, or Better Auth secrets.
#
# Get BOTH URLs from Neon Console > Project > Connect:
# 1. Toggle pooled connection ON -> DATABASE_URL (host includes '-pooler')
# 2. Toggle pooled connection OFF -> DATABASE_URL_DIRECT (direct host)
# Keep the same branch, database, and role for both strings; require TLS.
#
DATABASE_URL=postgresql://USER:REPLACE_ME@ep-your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:REPLACE_ME@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Local: http://localhost:3000; production: the actual HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 48 ; keep this stable across app deploys.
BETTER_AUTH_SECRET=REPLACE_WITH_OWN_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
